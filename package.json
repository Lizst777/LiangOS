    "test": "node --test",
    "verify:video": "node scripts/verify-video.mjs"
  },
  "dependencies": {
    "mediabunny": "1.55.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "prettier": "^3.9.6",
    "vite": "8.1.4"
  }
}
